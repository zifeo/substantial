# The stores of dev/compose.yaml as the tests reach them, read by the test harness of each host
# and by dev/cross/run.py. A variable set in the environment wins over its line here.
AWS_ACCESS_KEY_ID=substantial
AWS_SECRET_ACCESS_KEY=substantial-secret
SUBSTANTIAL_S3_URL=s3+http://127.0.0.1:39400/substantial-unversioned/tests?region=us-east-1
SUBSTANTIAL_S3_VERSIONED_URL=s3+http://127.0.0.1:39400/substantial/tests?region=us-east-1
SUBSTANTIAL_REDIS_URL=redis://127.0.0.1:39501/tests?db=0&replicas=0
SUBSTANTIAL_REDIS_SENTINEL_URL=redis+sentinel://127.0.0.1:39521,127.0.0.1:39522,127.0.0.1:39523/tests?master=substantial&db=0&replicas=all
SUBSTANTIAL_REDIS_CLUSTER_URL=redis+cluster://127.0.0.1:39531,127.0.0.1:39532/tests?replicas=all
